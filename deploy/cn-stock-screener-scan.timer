[Unit]
Description=Run intraday scan every 15 minutes during A-share sessions

[Timer]
# 09:45 起每 15 分钟（UTC+8）；cron 里等价于 45,0,15,30 9-15 * * 1-5
OnCalendar=Mon..Fri *-*-* 09:45:00
OnCalendar=Mon..Fri *-*-* 10:00:00
OnCalendar=Mon..Fri *-*-* 10:15:00
OnCalendar=Mon..Fri *-*-* 10:30:00
OnCalendar=Mon..Fri *-*-* 10:45:00
OnCalendar=Mon..Fri *-*-* 11:00:00
OnCalendar=Mon..Fri *-*-* 11:15:00
OnCalendar=Mon..Fri *-*-* 11:30:00
OnCalendar=Mon..Fri *-*-* 13:15:00
OnCalendar=Mon..Fri *-*-* 13:30:00
OnCalendar=Mon..Fri *-*-* 13:45:00
OnCalendar=Mon..Fri *-*-* 14:00:00
OnCalendar=Mon..Fri *-*-* 14:15:00
OnCalendar=Mon..Fri *-*-* 14:30:00
OnCalendar=Mon..Fri *-*-* 14:45:00
OnCalendar=Mon..Fri *-*-* 15:00:00
Persistent=false

[Install]
WantedBy=timers.target

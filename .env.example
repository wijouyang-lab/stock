# ============================================================================
# cn-stock-screener 环境变量模板
#
# 用法：
#   1) 把本文件复制为 .env           （Windows）  copy .env.example .env
#   2) 用记事本打开 .env，把 TUSHARE_TOKEN 换成你自己的 Token
#   3) 保存即可，程序每次启动都会自动读取项目根目录下的 .env
#
# 注意：
#   - .env 已在 .gitignore 中，不会被提交，也不会随代码分发给别人
#   - 也可以不建 .env，直接设置系统环境变量 TUSHARE_TOKEN（环境变量优先）
#   - Token 获取：https://tushare.pro/user/token
# ============================================================================

# Tushare Pro Token（必填）。需要 2000 积分权限。
TUSHARE_TOKEN=在这里填入你的_Tushare_Token

# ---- 以下均为可选，用来临时覆盖 config.py 里的默认值（一般不用改）----------

# 日志级别：DEBUG / INFO / WARNING / ERROR
#SCREENER_LOG_LEVEL=INFO

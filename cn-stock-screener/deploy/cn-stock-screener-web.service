[Unit]
Description=cn-stock-screener web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stock
WorkingDirectory=/opt/cn-stock-screener
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
# 认证：改成自己的用户名/密码（不要留空，公网必须开）
Environment=WEB_USER=admin
Environment=WEB_PASS=change-me-please
# 监听所有网卡；只给 Nginx 用的话改成 127.0.0.1
ExecStart=/usr/bin/python3 -m main --serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
